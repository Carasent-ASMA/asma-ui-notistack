{
    "name": "asma-ui-notistack",
    "publishConfig": {
        "access": "public"
    },
    "version": "0.2.0",
    "type": "module",
    "files": [
        "dist/**/*",
        "dist/style.css",
        "tw-configs/**/*"
    ],
    "keywords": [],
    "author": "asma-team",
    "types": "./dist/index.d.ts",
    "main": "./dist/asma-ui-notistack.es.js",
    "module": "./dist/asma-ui-notistack.es.js",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/asma-ui-notistack.es.js"
            }
        },
        "./dist/style.css": "./dist/style.css",
        "./tw-configs/twConfigs.json": "./tw-configs/twConfigs.json"
    },
    "scripts": {
        "dev": "vite",
        "build": "if [ ! -f configs/env.ts ]; then cp configs/env.example.ts configs/env.ts; fi && tsc && rm -rf ./dist && vite build",
        "preview": "vite preview",
        "lint": "eslint src/**/*.{js,jsx,ts,tsx}",
        "version": "echo $npm_package_version",
        "lint:fix": "eslint --fix src/**/*.{jsx,ts,tsx}",
        "prettier": "prettier --write src//**/*.{ts,tsx,scss} --config ./.prettierrc",
        "storybook": "storybook dev -p 6006",
        "storybook:no-browser": "storybook dev -p 6006 --no-open",
        "build-storybook": "export NODE_OPTIONS=--max_old_space_size=6240 && storybook build",
        "test-storybook": "test-storybook",
        "changeset:pre-beta": "changeset pre enter beta",
        "changeset:pre-exit": "changeset pre exit",
        "changeset:version": "changeset version",
        "changeset:publish": "changeset publish",
        "changeset:status": "changeset status"
    },
    "license": "UNLICENSED",
    "dependencies": {
        "@emotion/styled": "^11.11.0",
        "@iconify/react": "^6.0.2",
        "clsx": "^2.1.1",
        "notistack": "^3.0.1"
    },
    "devDependencies": {
        "@changesets/cli": "^2.26.2",
        "@faker-js/faker": "^8.0.2",
        "@storybook/addon-a11y": "^10.3.5",
        "@storybook/addon-docs": "^10.3.5",
        "@storybook/addon-links": "^10.3.5",
        "@storybook/addon-themes": "^10.3.5",
        "@storybook/react": "^10.3.5",
        "@storybook/react-vite": "^10.3.5",
        "@storybook/test-runner": "^0.24.3",
        "@types/lodash-es": "^4.17.7",
        "@types/node": "^25.5.2",
        "@types/react": "^18.3.28",
        "@types/react-dom": "^18.3.7",
        "@typescript-eslint/eslint-plugin": "^5.59.0",
        "@typescript-eslint/parser": "^5.59.0",
        "@vitejs/plugin-react": "^6.0.1",
        "autoprefixer": "^10.4.14",
        "axe-playwright": "^1.2.3",
        "axios": "^1.15.0",
        "esbuild": "^0.28.0",
        "eslint": "^8.38.0",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.3.4",
        "eslint-plugin-storybook": "^10.3.5",
        "@mui/material": "^5.13.7",
        "postcss": "^8.5.9",
        "prop-types": "^15.8.1",
        "storybook": "^10.3.5",
        "tailwind-scrollbar": "^3.1.0",
        "tailwindcss": "^3.3.2",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "typescript": "^6.0.2",
        "typescript-plugin-css-modules": "^5.0.1",
        "vite": "^8.0.8",
        "vite-plugin-dts": "^4.5.4"
    },
    "peerDependencies": {
        "@mui/material": "^5.13.7",
        "immer": "^9.0.21",
        "react": "^18.2.0 || ^19.0.0",
        "react-dom": "^18.2.0 || ^19.0.0"
    },
    "resolutions": {
        "@types/node": "18.0.3",
        "node": "18.17.0"
    }
}
